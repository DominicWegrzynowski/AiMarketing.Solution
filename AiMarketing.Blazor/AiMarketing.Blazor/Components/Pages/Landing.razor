@page "/"
@using AiMarketing.Blazor.Components.Layout
@layout LandingLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer

<!-- ================= HERO ================= -->
<section class="bg-primary bg-gradient text-white py-5">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">Create a month of social posts in seconds</h1>
        <p class="lead mt-2 mb-4">
            Set your brand voice, generate quality posts, and publish fast—without hiring a marketer.
        </p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <button class="btn btn-light btn-lg text-primary fw-semibold" @onclick="NavigateToRegister">
                Get Started Free
            </button>
            @* <a href="#video" class="btn btn-light btn-lg text-primary fw-semibold">Watch Quick Demo</a> *@
        </div>
        <div class="d-flex justify-content-center mt-3">
            <button class="btn btn-light btn-lg text-primary fw-semibold" @onclick="NavigateToLogin">
                Returning User? Log In
            </button>
        </div>
        <div class="text-white-50 small mt-2">No credit card required • 3 free posts</div>
    </div>
</section>

