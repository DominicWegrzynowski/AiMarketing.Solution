@page "/manage-membership"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@inject NavigationManager _navigationManager
@inject IBillingService _billingService
@inject UserManager<ApplicationUser> _userManager
@inject AuthenticationStateProvider _auth
@inject IConfiguration Configuration
@rendermode InteractiveServer

@if(flagHasMembership != true)
{
    <section id="pricing" class="py-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="fw-bold mt-1 mb-0">Available Plans</h2>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-4 align-items-stretch">
                <!-- Starter -->
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-body-tertiary text-center fw-semibold">Starter</div>
                        <div class="card-body text-center d-flex flex-column">
                            <h3 class="fw-bold mb-0">$19.99</h3>
                            <div class="text-secondary mb-3">No card required</div>
                            <ul class="list-unstyled small text-start mx-auto mb-4" style="max-width:260px">
                                <li>• 10 Posts/month</li>
                                <li>• All core features</li>
                                <li>• Brand voice saved</li>
                            </ul>
                            <div class="mt-auto">

                                <button class="btn btn-outline-primary w-100"
                                        disabled="@(_loadingProductId is not null)"
                                        @onclick="() => StartCheckout(starterStripeProductId)">
                                    @if (_loadingProductId == starterStripeProductId)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Redirecting…</span>
                                    }
                                    else
                                    {

                                        <span>Get Started</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Growth (Most popular) -->
                <div class="col">
                    <div class="card h-100 border-primary shadow">
                        <div class="card-header bg-primary bg-gradient text-white text-center fw-semibold">
                            Growth <span class="badge text-bg-light text-primary ms-2">Most popular</span>
                        </div>
                        <div class="card-body text-center d-flex flex-column">
                            <h3 class="fw-bold mb-0">$39.99<span class="fs-6 text-secondary">/mo</span></h3>
                            <div class="text-secondary mb-3">For consistent posting</div>
                            <ul class="list-unstyled small text-start mx-auto mb-4" style="max-width:260px">
                                <li>• 25 posts / month</li>
                                <li>• All core features</li>
                                <li>• Brand voice saved</li>
                            </ul>
                            <div class="mt-auto">
                                <button class="btn btn-primary w-100"
                                        disabled="@(_loadingProductId is not null)"
                                        @onclick="() => StartCheckout(growthStripeProductId)">
                                    @if (_loadingProductId == growthStripeProductId)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Redirecting…</span>
                                    }
                                    else
                                    {

                                        <span>Upgrade</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pro -->
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-body-tertiary text-center fw-semibold">Pro</div>
                        <div class="card-body text-center d-flex flex-column">
                            <h3 class="fw-bold mb-0">$59.99<span class="fs-6 text-secondary">/mo</span></h3>
                            <div class="text-secondary mb-3">For active brands</div>
                            <ul class="list-unstyled small text-start mx-auto mb-4" style="max-width:260px">
                                <li>• 35 posts / month</li>
                                <li>• All core features</li>
                                <li>• Brand voice saved</li>
                            </ul>
                            <div class="mt-auto">
                                <button class="btn btn-outline-primary w-100"
                                        disabled="@(_loadingProductId is not null)"
                                        @onclick="() => StartCheckout(proStripeProductId)">
                                    @if (_loadingProductId == proStripeProductId)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Redirecting…</span>
                                    }
                                    else
                                    {

                                        <span>Upgrade</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="text-center text-secondary small mt-3 mb-0">Powered by Stripe • Cancel anytime</p>
        </div>
    </section>
}
else
{
    <h3>Redirecting...</h3>
}
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="text-danger mt-2">@ErrorMessage</div>
}

@code {
    private string? ErrorMessage;
    private bool flagHasMembership = false;
    private string? _loadingProductId;
    private ApplicationUser? currentUser;
    private string starterStripeProductId = "";
    private string growthStripeProductId = "";
    private string proStripeProductId = "";

    protected override async Task OnInitializedAsync()
    {
        starterStripeProductId = Configuration.GetValue<string>("Stripe:StarterProductId")!;
        growthStripeProductId = Configuration.GetValue<string>("Stripe:GrowthProductId")!;
        proStripeProductId = Configuration.GetValue<string>("Stripe:ProProductId")!;

        var authState = await _auth.GetAuthenticationStateAsync();
        var user = await _userManager.GetUserAsync(authState.User);

        if (user == null) return;
        currentUser = user;

        //Check with stripe first, dont rely on stale db
        if (!string.IsNullOrEmpty(currentUser.StripeCustomerId) &&
             string.IsNullOrEmpty(currentUser.StripeSubscriptionId))
        {
            await _billingService.SyncSubscriptionFromStripe(currentUser);
        }

        if (!string.IsNullOrEmpty(currentUser.StripeCustomerId) && !string.IsNullOrEmpty(currentUser.StripeSubscriptionId))
        {
            flagHasMembership = true;
            StateHasChanged();
            await LaunchPortal();
        }
    }


    private async Task StartCheckout(string productId)
    {
        ErrorMessage = null;
        _loadingProductId = productId;   // show spinner
        StateHasChanged();

        try
        {
            var authState = await _auth.GetAuthenticationStateAsync();
            var user = authState.User;

            var url = await _billingService.StartCheckoutAsync(productId, user);
            if (!string.IsNullOrEmpty(url))
            {
                _navigationManager.NavigateTo(url, forceLoad: true);
                return; // navigating away; no need to clear here
            }

            if(url is null)
            {
                // user already subscribed -> send them to portal instead
                await LaunchPortal();
                return;
            }

            ErrorMessage = "Failed to create checkout session.";
        }
        catch(Exception ex)
        {
            ErrorMessage = "Something went wrong. Please try again." + ex;
        }
        finally
        {
            // If navigation didn’t happen, restore button content
            _loadingProductId = null;
            StateHasChanged();
        }
    }


    private async Task LaunchPortal()
    {
        var authState = await _auth.GetAuthenticationStateAsync();
        var userClaimsPrincipal = authState.User;

    
        var portalUrl = await _billingService.CreatePortalSessionAsync(userClaimsPrincipal);
        if (!string.IsNullOrEmpty(portalUrl))
        {
            _navigationManager.NavigateTo(portalUrl, forceLoad: true);
        }
        else
        {
            Console.WriteLine("Failed to create Stripe portal session");
        }
    }


    private class StripeRedirectResponse
    {
        public string? SessionUrl { get; set; }
    }

}