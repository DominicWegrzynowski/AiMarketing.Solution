@page "/generate-posts"
@using AiMarketing.Blazor.Services.AllowanceService
@using AiMarketing.Blazor.Services.SeedService
@using AiMarketing.Blazor.Components.Shared
@inject IPostService _postService
@inject UserManager<ApplicationUser> _userManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IOpenAiService _openAiService
@inject IJSRuntime JS
@inject ISeedService _seedService
@inject IBusinessProfileService _profileService
@inject IAllowanceService _allowanceService
@rendermode InteractiveServer

<h3>Generate AI-Powered Social Media Posts</h3>

@if(currentUser is not null)
{
    <div>
        <p><strong>Your current role: </strong>@currentRole</p>

        <!-- Role Upgrade Options: -->
        @if (currentRole == "TrialUser")
        {
            <div>
                <h4>Upgrade to Basic User for $50/month</h4>
                <button @onclick="async () => await UpgradeRole(UserRole.BasicUser)">Upgrade to Basic User</button>
            </div>
            <div>
                <h4>Upgrade to Premium User for $100/month</h4>
                <button @onclick="async () => await UpgradeRole(UserRole.PremiumUser)">Upgrade to Premium User</button>
            </div>
        }
        @if(currentRole == "BasicUser")
        {
            <div>
                <h4>Upgrade to Premium User for $100/month</h4>
                <button @onclick="async () => await UpgradeRole(UserRole.PremiumUser)">Upgrade to Premium User</button>
            </div>
        }

        <!-- Monthly Post Allowance -->
        <p><strong>Monthly Posts Allowance</strong> @monthlyPostAllowance posts</p>

        <div>
            <label for="numberOfPosts">Enter the number of posts to generate today:</label>
            <input type="number" id="numberOfPosts" @bind="numberOfPosts" min="1" max="@currentUser.MonthlyPostAllowance" />
            <button @onclick="async () => await GeneratePostAsync()">Generate Post(s)</button>
        </div>
        @if (isLoading)
        {
            <div class="d-flex justify-content-center my-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }

        <!-- Show generated Posts -->
        @if(generatedPosts.Any())
        {
            <p><strong>Generated Posts</strong></p>
            @foreach(var post in generatedPosts)
            {
                <PostCard Post="post"
                          Editable="true"
                          OnPostUpdated="RefreshPosts"/>
            }
        }

    </div>
}
else 
{
    <p>Please log in to generate posts</p>
}


@code {
    private BusinessProfileDTO? businessProfile;
    private List<Post> generatedPosts = new();
    private ApplicationUser? currentUser;
    private string currentRole = "TrialUser";
    private int monthlyPostAllowance = 5;
    private int numberOfPosts = 1;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity is { IsAuthenticated: true })
        {
            currentUser = await _userManager.GetUserAsync(userPrincipal);
            var roles = await _userManager.GetRolesAsync(currentUser!);
            currentRole = roles.FirstOrDefault() ?? "TrialUser";

            await _allowanceService.RefreshAllowanceIfNeededAsync(currentUser);
            monthlyPostAllowance = currentUser.MonthlyPostAllowance;

            businessProfile = await FetchBusinessProfile();
        }
    }


    private async Task<BusinessProfileDTO> FetchBusinessProfile()
    {
        if(currentUser is not null)
        {
            var profile = await _profileService.GetProfileByUserIdAsync(currentUser.Id);
            if(profile is not null)
            {
                return new BusinessProfileDTO
                {
                    BusinessName = profile.BusinessName,
                    Industry = profile.Industry,
                    Services = profile.Services,
                    TargetAudience = profile.TargetAudience,
                    BrandVoices = profile.BrandVoices.Select(bv => bv.Voice).ToList()
                };
            } 
            else 
            {
                return null!;
            }

        }
        else 
        {
            return null!;
        }
    }            

    private async Task UpgradeRole(UserRole role)
    {
        //For now directly assign the role
        await _seedService.AssignRoleToUser(currentUser!, role);
        currentRole = role.ToString();

        // In the future, I will redirect to Stripe and handle the payment process there.
        // Simulate that the role was upgrade and remove upgrade actions
    }

    private async Task GeneratePostAsync()
    {
        if (businessProfile is null || currentUser is null)
            return;

        isLoading = true;
        StateHasChanged();

        // Reset allowance if period expired
        await _allowanceService.RefreshAllowanceIfNeededAsync(currentUser);

        // Validate remaining allowance
        var canGenerate = await _allowanceService.CanGeneratePostsAsync(currentUser, numberOfPosts);
        if (!canGenerate)
        {
            isLoading = false;
            await JS.InvokeVoidAsync("alert", "You don’t have enough posts remaining. Please upgrade your plan.");
            return;
        }

        // Generate posts from OpenAI
        var aiPosts = await _openAiService.GenerateMarketingPostsAsync(businessProfile, numberOfPosts);
        var posts = aiPosts.Select(p => new Post
        {
            UserId = currentUser.Id,
            Content = p.Content,
            ImageRecommendation = p.ImageRecommendation,
            ScheduledTime = null,
            IsPosted = false,
        }).ToList();

        generatedPosts.Clear();
        generatedPosts.AddRange(posts);

        // Save to DB and deduct allowance
        await _postService.AddPostsAsync(posts);
        await _allowanceService.DeductPostsAsync(currentUser, numberOfPosts);

        monthlyPostAllowance = currentUser.MonthlyPostAllowance;

        isLoading = false;
        StateHasChanged();
    } 
    private async Task RefreshPosts() =>
    generatedPosts = await _postService.GetUserPostsAsync(currentUser!.Id);

}