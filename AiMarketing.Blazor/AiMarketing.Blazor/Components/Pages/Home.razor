@page "/"
@inject IPostService _postService
@inject UserManager<ApplicationUser> _userManager
@inject AuthenticationStateProvider AuthStateProvider
@using AiMarketing.Blazor.Components.Shared;
@rendermode InteractiveServer
<div class="row">
    <div class="col-8">
        <PageTitle>Home</PageTitle>
        @if(currentUser is not null)
        {
            <h1>Hello @currentUser.FirstName ! Welcome Back.</h1>
            <h2>Here are your posts:</h2>
        }
        else 
        {
            <h1> Welcome to AiMarketer</h1>
        }




        @if (generatedPosts is not null && generatedPosts.Any())
        {
            <p><strong>Generated Post:</strong></p>
            @foreach (var post in generatedPosts!)
            {
                <PostCard Post="post"
                          Editable="true"
                          OnPostUpdated="RefreshPosts" />
            }
        }
    </div>
</div>
@code {
    private ApplicationUser? currentUser;
    private List<Post>? generatedPosts = new List<Post>();
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity is { IsAuthenticated: true })
        {
            currentUser = await _userManager.GetUserAsync(userPrincipal);
        }

        if(currentUser is not null)
        {
            generatedPosts =  await _postService.GetUserPostsAsync(currentUser!.Id);
        }
        StateHasChanged();
    }
    private async Task RefreshPosts() =>
        generatedPosts = await _postService.GetUserPostsAsync(currentUser!.Id);
}