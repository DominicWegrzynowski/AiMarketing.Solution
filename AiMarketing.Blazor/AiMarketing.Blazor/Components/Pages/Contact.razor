@page "/contact"
@rendermode InteractiveServer
<PageTitle>Contact Us</PageTitle>

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h2 class="fw-bold mb-3">Contact Us</h2>
                    <p class="mb-4">
                        Have questions, feedback, or need support? Reach out to us anytime.
                    </p>
                    <div class="mb-3">
                        <i class="bi bi-envelope-fill text-primary" style="font-size:2rem;"></i>
                    </div>
                    <a href="mailto:admin@prompt-n-post.com" class="btn btn-outline-primary btn-lg">
                        admin@prompt-n-post.com
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>