@page "/generate-post"
@using AiMarketing.Blazor.Components.Account
@using AiMarketing.Blazor.Data
@using AiMarketing.Blazor.Services.PostService
@using Microsoft.AspNetCore.Identity
@inject IPostService _postService
@inject UserManager<ApplicationUser> _userManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<h3>Generate Social Media Post</h3>

<select title="businessType" @bind="businessType">
    <option value="Coffee Shop">Coffee Shop</option>
    <option value="Fitness Coach">Fitness Coach</option>
    <option value="General">General</option>
</select>

<button @onclick="async => GeneratePostAsync()">Generate Post</button>
<p>@debugMessage</p>
@if(!string.IsNullOrEmpty(postContent))
{
    <p><strong>Generated Post:</strong></p>
    <p>@postContent</p>
}

@code {
    private string businessType = "General";
    private string postContent = "";
    private ApplicationUser? currentUser;
    private string debugMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity is { IsAuthenticated: true })
        {
            currentUser = await _userManager.GetUserAsync(userPrincipal);
        }
    }

    private async Task GeneratePostAsync()
    {
        if (currentUser != null)
        {
            debugMessage = "User Found, gathering post... ";
            StateHasChanged();
            var post = await _postService.GeneratePostAsync(currentUser.Id, businessType);
            postContent = post.Content;
            
        }
        else
        {
            debugMessage = "Error: No logged-in user found.";
        }
    }
}