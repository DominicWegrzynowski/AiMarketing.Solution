        <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Smooth scroll helper
        window.scrollToTop = () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        // === UNIVERSAL COPY FUNCTION ===
        window.copyToClipboard = async function (text) {
          try {
            // Use modern clipboard API if available and focused
            if (navigator.clipboard && window.isSecureContext && document.hasFocus()) {
              try {
                await navigator.clipboard.writeText(text);
                alert("✅ Copied via secure clipboard API");
                return true;
              } catch (err) {
                alert("⚠️ Secure copy failed: " + err);
                return fallbackCopy(text);
              }
            } else {
              // Fallback for unfocused or insecure contexts
              return fallbackCopy(text);
            }
          } catch (err) {
            alert("❌ Clipboard copy failed (outer catch): " + err);
            return false;
          }
        };

        // === FALLBACK COPY FOR DESKTOP & ANDROID ===
        function fallbackCopy(text) {
          const textArea = document.createElement("textarea");
          textArea.value = text;
          textArea.style.position = "fixed";
          textArea.style.top = "0";
          textArea.style.left = "0";
          textArea.style.opacity = "0";
          document.body.appendChild(textArea);

          textArea.focus({ preventScroll: true });
          textArea.select();

          let success = false;
          try {
            success = document.execCommand("copy");
            alert(success ? "✅ Copied via fallback!" : "❌ execCommand returned false");
          } catch (e) {
            alert("❌ execCommand error: " + e);
          }

          document.body.removeChild(textArea);
          return success;
        }

        // === iOS DEVICE DETECTION ===
        window.isIOS = () => /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

        // === DIRECT COPY FOR SAFARI / iOS ===
        window.directCopy = function (text) {
          try {
            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.top = "0";
            textArea.style.left = "0";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);

            textArea.focus({ preventScroll: true });
            textArea.select();

            const success = document.execCommand("copy");
            document.body.removeChild(textArea);

            alert(success ? "✅ iOS direct copy succeeded!" : "❌ iOS direct copy failed");
            return success;
          } catch (e) {
            alert("❌ directCopy error: " + e);
            return false;
          }
        };

    </script>

</body>

