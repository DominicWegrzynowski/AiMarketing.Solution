    <script>
        function copyIOSSafe(elementId) {
          const input = document.getElementById(elementId);

          // Temporarily make sure it’s focusable
          input.removeAttribute("readonly");
          input.focus();
          input.select();

          try {
            const success = document.execCommand("copy");
            alert(success ? "✅ Copied!" : "❌ Failed to copy");
          } catch (err) {
            alert("❌ Copy blocked: " + err);
          }

          // Restore readonly
          input.setAttribute("readonly", "");
          window.getSelection().removeAllRanges();
        }
    </script>

