@inject IPostService _postService
@inject IJSRuntime JS
@rendermode InteractiveServer

@code {
    [Parameter] public Post Post { get; set; } = new Post();
    [Parameter] public EventCallback OnPostUpdated { get; set; }

    private bool isEditing = false;
    private string tempContent = string.Empty;
    private string tempImageRecommendation = string.Empty;
    private bool copySuccess = false;
    protected override void OnParametersSet()
    {
        if(!isEditing)
        {
            tempContent = Post.Content;
            tempImageRecommendation = Post.ImageRecommendation ?? string.Empty;
        }
    }

    private async Task SaveEdit()
    {
        Post.Content = tempContent;
        Post.ImageRecommendation = tempImageRecommendation;

        await _postService.UpdatePostAsync(Post);
        isEditing = false;
        if(OnPostUpdated.HasDelegate)
        {
            await OnPostUpdated.InvokeAsync();
        }
    }

    private async Task CopyToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Post.Content);
            copySuccess = true;
            StateHasChanged();
            await Task.Delay(2000);
            copySuccess = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clipboard error: {ex.Message}");
        }
    }


    private void StartEdit() => isEditing = true;
    private void CancelEdit() => isEditing = false;
}


<div class="card w-100 h-100 d-flex flex-column ">
    <div class="card-body d-flex flex-column justify-content-between flex-grow-1">
        @if(isEditing)
        {
            <textarea class="form-control mb-2" @bind="tempContent" rows="4"></textarea>
            <textarea class="form-control mb-2" @bind="tempImageRecommendation" rows="4"></textarea>

            <div class="mt-auto">
                <button class="btn btn-success me-2" @onclick="SaveEdit">Save</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            </div>
        }
        else
        {
            <div class="flex-grow-1">
                <p>@Post.Content</p>
                <p class="text-muted"><strong>Image Recommendation:</strong> @Post.ImageRecommendation</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-auto">

                <!-- actions: edit/copy -->
                <div class="d-flex gap-2">
                    <button class="btn btn-warning" title="Edit post" @onclick="StartEdit">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="btn btn-success" title="Copy post" @onclick="CopyToClipboard">
                        <i class="bi bi-copy"></i>
                    </button>
                </div>

                <!-- separator only on md+ -->
                <div class="vr mx-2 d-none d-md-block"></div>

                <!-- force wrap below md so socials start on a new row -->
                <div class="w-100 d-md-none"></div>

                <!-- socials -->
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-outline-primary btn-icon" title="Open Instagram" target="_blank" rel="noopener noreferrer" href="https://instagram.com">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a class="btn btn-outline-primary btn-icon" title="Open Facebook" target="_blank" rel="noopener noreferrer" href="https://facebook.com">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a class="btn btn-outline-primary btn-icon" title="Open X" target="_blank" rel="noopener noreferrer" href="https://x.com">
                        <i class="bi bi-twitter-x"></i>
                    </a>
                    <a class="btn btn-outline-primary btn-icon" title="Open Linkedin" target="_blank" rel="noopener noreferrer" href="https://linkedin.com">
                        <i class="bi bi-linkedin"></i>
                    </a>
                    <a class="btn btn-outline-primary btn-icon" title="Open Threads" target="_blank" rel="noopener noreferrer" href="https://threads.com">
                        <i class="bi bi-threads"></i>
                    </a>
                </div>
            </div>
        }
    </div>
    <div class="card-footer" text-muted small>
        Created: @Post.CreatedWhen.ToString("M/d/yyyy") | Last Updated: @Post.ModifiedWhen.ToString("M/d/yyyy")
    </div>
</div>
